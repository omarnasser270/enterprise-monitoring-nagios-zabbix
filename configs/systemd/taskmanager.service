[Unit]
Description=Task Manager Flask API
After=network.target

[Service]
User=www-data
WorkingDirectory=/opt/taskmanager
Environment=DB_HOST=192.168.56.23
Environment=DB_USER=taskuser
Environment=DB_PASS=TaskPass123!
Environment=DB_NAME=taskdb
ExecStart=/opt/taskmanager/venv/bin/gunicorn --workers 1 --threads 4 --bind 0.0.0.0:5000 app:app
Restart=always

[Install]
WantedBy=multi-user.target
